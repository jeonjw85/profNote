{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "profNote",
    "version": "0.2.2",
    "identifier": "kr.jjw.profNote",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "profNote",
                "width": 1120,
                "height": 740,
                "minWidth": 940,
                "minHeight": 600,
                "center": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "plugins": {
        "updater": {
            "endpoints": [
                "https://github.com/jeonjw85/profNote/releases/latest/download/latest.json"
            ],
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4RjdGQ0M4N0REREMyQzAKUldUQXd0MTl5UHozbUd1T1FZN3ovdnFNdGpJM1pyQW1sU2FQSUpiUlQzQk02MndIQmtsTWlDQy8K"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "macOS": {
            "minimumSystemVersion": "10.15"
        },
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
